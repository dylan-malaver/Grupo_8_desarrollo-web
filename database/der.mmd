erDiagram
    USER_CATEGORIES ||--o{ USERS : "clasifica"
    CATEGORIES ||--o{ PRODUCTS : "agrupa"
    PRODUCTS ||--o{ PRODUCT_COLOR : "tiene"
    COLORS ||--o{ PRODUCT_COLOR : "se usa en"

    USER_CATEGORIES {
        int id PK
        varchar name UK
    }
    USERS {
        int id PK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar phone
        varchar password
        varchar image
        int user_category_id FK
    }
    CATEGORIES {
        int id PK
        varchar name UK
        varchar slug UK
    }
    COLORS {
        int id PK
        varchar name UK
        varchar swatch
    }
    PRODUCTS {
        int id PK
        varchar name
        varchar summary
        text description
        text details
        text care
        int price
        varchar image
        varchar alt
        int category_id FK
    }
    PRODUCT_COLOR {
        int product_id PK,FK
        int color_id PK,FK
    }