<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="product-form">
  <h1><%= product ? 'Editar producto' : 'Nuevo producto' %></h1>

  <form action="<%= product ? '/productos/editar/' + product.id : '/productos/crear' %>" method="POST">

    <label for="name">Nombre del producto</label>
    <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required minlength="3">

    <label for="description">Descripción</label>
    <textarea id="description" name="description" required minlength="10"><%= product ? product.description : '' %></textarea>

    <label for="image">Imagen (nombre de archivo en public/img)</label>
    <input type="text" id="image" name="image" value="<%= product ? product.image : '' %>" placeholder="ej: prod-rosas-rojas.jpg" required>

    <label for="category">Categoría</label>
    <select id="category" name="category" required>
      <option value="">Seleccionar categoría</option>
      <% categories.forEach(function(cat) { %>
        <option value="<%= cat.name %>" <%= product && product.category === cat.name ? 'selected' : '' %>>
          <%= cat.name %>
        </option>
      <% }) %>
    </select>

    <label for="colors">Colores</label>
    <input type="text" id="colors" name="colors" value="<%= product && product.colors ? product.colors : '' %>" placeholder="Ej: rojo, blanco, rosa">

    <label for="price">Precio</label>
    <input type="number" id="price" name="price" value="<%= product ? product.price : '' %>" required min="0" step="1000">

    <button type="submit"><%= product ? 'Guardar cambios' : 'Crear producto' %></button>
  </form>
</main>

<%- include('../partials/footer') %>