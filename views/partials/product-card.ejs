<article class="product-card" data-id="<%= product.id %>">
    <img src="/img/<%= product.image %>" alt="<%= product.alt %>">
    <div class="product-body">
        <h3><%= product.name %></h3>
        <% if (!locals.compact) { %>
        <p><%= product.summary %></p>
        <% } %>
        <p class="price"><%= formatPrice(product.price) %></p>
        <div class="product-actions">
            <a href="/detalle/<%= product.id %>" class="btn-rose">Ver producto</a>
            <a href="/carrito?producto=<%= product.id %>" class="cart-link" aria-label="Agregar <%= product.name %> al carrito">🛒</a>
            <a href="/productos/editar/<%= product.id %>" class="cart-link" aria-label="Editar <%= product.name %>">✏️</a>
        </div>
    </div>
</article>